generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Phase {
  Open
  SaleClosed
  Committed
  Drawn
  Slashed
}

model Round {
  id    Int   @id
  phase Phase @default(Open)

  secret        String?
  committedHash String?
  collateral    String?
  targetBlock   BigInt?

  revealedAt   DateTime?
  revealTxHash String?

  winner    String?
  prizePool String?

  commitTxHash    String?
  closeSaleTxHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userlog UserLog[]
}

model UserLog {
  id        Int      @id @default(autoincrement())
  roundId   Int
  round     Round    @relation(fields: [roundId], references: [id])
  action    String
  txHash    String?
  createdAt DateTime @default(now())

  @@index([roundId])
}
